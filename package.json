{
  "name": "automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "e2e": "tsx index.ts",
    "e2e:dev": "cross-env ENV=dev tsx index.ts",
    "e2e:qa": "cross-env ENV=qa tsx index.ts",
    "e2e:stg": "cross-env ENV=stg tsx index.ts",
    "pw:open": "npx playwright test --ui",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "allure-playwright": "^3.6.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
